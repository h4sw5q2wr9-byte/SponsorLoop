{
  "rules": {
    "sessions": {
      "$code": {
        ".read": "$code.matches(/^[A-Z0-9]{5,12}$/)",
        ".write": "auth != null && $code.matches(/^[A-Z0-9]{5,12}$/) && (root.child('pins').child($code).exists() ? root.child('members').child($code).child(auth.uid).val() === root.child('pins').child($code).child('pin').val() : (!data.exists() || data.child('owner').val() === auth.uid))",
        ".validate": "newData.hasChildren(['updatedAt', 'owner'])",
        "owner": {
          ".validate": "newData.val() === auth.uid"
        },
        "classes": {
          "$i": {
            ".validate": "$i.matches(/^[0-9]{1,2}$/) && newData.hasChildren(['name', 'laps'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length <= 60"
            },
            "laps": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 100000"
            },
            "color": {
              ".validate": "newData.isString() && newData.val().length <= 9"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "schoolGoal": {
          ".validate": "newData.isNumber()"
        },
        "updatedAt": {
          ".validate": "newData.isNumber()"
        },
        "seenAt": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "feedback": {
      "$id": {
        ".write": "auth != null && !data.exists() && $id.beginsWith(auth.uid + '_')",
        ".validate": "newData.hasChildren(['type', 'message', 'createdAt'])",
        "type": {
          ".validate": "newData.val() === 'idee' || newData.val() === 'probleem'"
        },
        "message": {
          ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 1500"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "info": {
          ".validate": "newData.isString() && newData.val().length <= 1500"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && newData.val() <= now + 60000"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "pins": {
      "$code": {
        ".write": "auth != null && $code.matches(/^[A-Z0-9]{5,12}$/) && (data.exists() ? root.child('members').child($code).child(auth.uid).val() === root.child('pins').child($code).child('pin').val() : (!root.child('sessions').child($code).exists() || root.child('sessions').child($code).child('owner').val() === auth.uid))",
        ".validate": "newData.hasChildren(['pin', 'lastUsed'])",
        "pin": {
          ".validate": "newData.isString() && newData.val().length >= 6 && newData.val().length <= 64"
        },
        "lastUsed": {
          ".validate": "newData.isNumber() && newData.val() <= now + 60000"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "members": {
      "$code": {
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && root.child('pins').child($code).exists() && newData.val() === root.child('pins').child($code).child('pin').val()",
          ".validate": "newData.isString()"
        }
      }
    }
  }
}